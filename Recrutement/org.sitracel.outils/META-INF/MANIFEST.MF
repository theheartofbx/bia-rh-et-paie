Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Outils
Bundle-SymbolicName: org.sitracel.outils
Bundle-Version: 1.0.0.qualifier
Export-Package: org.sitracel.bean,
 org.sitracel.beanfactory,
 org.sitracel.controller,
 org.sitracel.enumeration,
 org.sitracel.time,
 org.sitracel.employe,
 org.sitracel.conge,
 org.sitracel.parametrage,
 org.sitracel.organigramme
Require-Bundle: org.adempiere.base;bundle-version="4.1.0",
 org.adempiere.plugin.utils;bundle-version="4.1.0",
 org.sitracel.model;bundle-version="1.0.0",
 org.sitracel.organigramme.model;bundle-version="1.0.0",
 org.sitracel.paie.model;bundle-version="1.0.0",
 org.sitracel.recrutement.model;bundle-version="1.0.0",
 org.sitracel.mission.model;bundle-version="1.0.0",
 org.sitracel.discipline.model;bundle-version="1.0.0",
 org.sitracel.conge.model;bundle-version="1.0.0"
Service-Component: OSGI-INF/*.xml
Automatic-Module-Name: org.sitracel.outils
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
