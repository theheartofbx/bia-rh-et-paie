Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Callout
Bundle-SymbolicName: org.sitracel.callout
Bundle-Version: 1.0.0.qualifier
Export-Package: org.sitracel.callout.bean,
 org.sitracel.callout.beanfactory,
 org.sitracel.callout.organigramme,
 org.sitracel.general.controller
Import-Package: javax.mail;version="1.6.0",
